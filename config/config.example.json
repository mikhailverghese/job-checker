{
  "search_terms": [
    "Analytics Engineer",
    "Data Engineer",
    "BI Engineer",
    "BI Analyst",
    "Data Analyst"
  ],
  "location_keywords": [
    "new york, ny",
    "new york city",
    "nyc",
    "new jersey",
    "nj",
    "jersey city",
    "hoboken",
    "newark",
    "remote"
  ],
  "time_keywords": [
    "24 hours",
    "1 day",
    "today",
    "just now",
    "hour",
    "hours"
  ],
  "title_keywords": [
    "analytics engineer",
    "data engineer",
    "bi engineer",
    "bi analyst",
    "data analyst"
  ],
  "weights": {
    "positive": {
      "python": 3,
      "sql": 3,
      "dbt": 3,
      "snowflake": 3,
      "bigquery": 3,
      "google bigquery": 3,
      "etl": 2,
      "elt": 2,
      "aws": 2,
      "power bi": 2,
      "cursor": 1,
      "codex": 1
    },
    "negative": {
      "senior": -3,
      "kafka": -2,
      "airflow": -2,
      "spark": -2
    }
  },
  "filters": {
    "min_score": 4,
    "min_positive_matches": 2,
    "reject_if_title_contains": ["senior"],
    "include_remote": true
  },
  "linkedin": {
    "email_env": "LINKEDIN_EMAIL",
    "password_env": "LINKEDIN_PASSWORD",
    "headless": true,
    "max_jobs_per_search": 25,
    "slow_mo_ms": 0
  },
  "debug": {
    "enabled": true,
    "screenshots_dir": "output/debug/screenshots",
    "html_dir": "output/debug/html",
    "save_login_screenshot": true,
    "save_search_screenshot": true,
    "save_first_detail_screenshot": true,
    "save_html_on_failure": true
  },
  "storage": {
    "seen_jobs_path": "data/seen_jobs.json",
    "matched_jobs_json": "output/matched_jobs.json",
    "matched_jobs_csv": "output/matched_jobs.csv",
    "raw_jobs_json": "output/raw_jobs.json"
  }
}
